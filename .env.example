APP_NAME=expense-categoriser
APP_ENV=production
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_SITE_ADDRESS=expenses.example.com
ALLOW_REGISTRATION=true
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=7
AUTH_THROTTLE_SECRET=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-one-time-random-secret
PUBLIC_APP_URL=https://expenses.example.com
MAIL_FROM=noreply@expenses.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=


